{
  "name": "turbo-imap",
  "version": "1.1.0",
  "description": "Interface grafica Electron para a suite de ferramentas IMAP de Rick Sanders",
  "main": "src/main/main.js",
  "author": "Turbo IMAP",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "postinstall": "node tools/copy-vendor.js",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --dir",
    "prebuild": "node tools/prepare-perl.js && node tools/prepare-sqlite.js win32 x64",
    "prebuild:dir": "node tools/prepare-perl.js && node tools/prepare-sqlite.js win32 x64",
    "prepare:perl": "node tools/prepare-perl.js",
    "restore:sqlite:linux": "npm rebuild sqlite3",
    "build:win": "electron-builder --win",
    "prebuild:win": "node tools/prepare-perl.js && node tools/prepare-sqlite.js win32 x64",
    "build:linux": "electron-builder --linux",
    "prebuild:linux": "node tools/prepare-sqlite.js linux x64",
    "build:mac": "npm run build:mac:x64 && npm run build:mac:arm64",
    "build:mac:x64": "electron-builder --mac zip --x64",
    "prebuild:mac:x64": "node tools/prepare-sqlite.js darwin x64",
    "build:mac:arm64": "electron-builder --mac zip --arm64",
    "prebuild:mac:arm64": "node tools/prepare-sqlite.js darwin arm64",
    "prepare:sqlite": "node tools/prepare-sqlite.js"
  },
  "dependencies": {
    "bulma": "^1.0.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "unzipper": "^0.12.5"
  },
  "build": {
    "appId": "com.turboimap.app",
    "productName": "Turbo IMAP",
    "copyright": "Turbo IMAP",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico",
      "extraResources": [
        {
          "from": "vendor/strawberry",
          "to": "strawberry",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/logo.png",
      "category": "Network"
    },
    "npmRebuild": false,
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "assets/logo.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emileite/turbo-imap.git"
  },
  "homepage": "https://github.com/emileite/turbo-imap",
  "bugs": {
    "url": "https://github.com/emileite/turbo-imap/issues"
  }
}
